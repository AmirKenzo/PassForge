{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PassForge",
  "version": "1.0.5",
  "identifier": "dev.passforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:native"
  },
  "app": {
    "windows": [
      {
        "title": "PassForge",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#fafafa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

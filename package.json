{
  "name": "passforge",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "description": "Privacy-first, open-source security toolkit — everything runs locally in your browser.",
  "author": "Amir Kenzo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amirkenzo/PassForge.git"
  },
  "homepage": "https://passforge.dev",
  "keywords": [
    "password-generator",
    "security",
    "privacy",
    "open-source",
    "passphrase",
    "hash-generator",
    "uuid-generator"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-version.mjs && tsc -b && vite build && node scripts/copy-spa-fallback.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "build:native": "node scripts/sync-version.mjs && tsc -b && vite build --mode native",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:native && tauri build",
    "cap:sync": "npm run build:native && cap sync",
    "cap:android": "npm run build:native && cap sync android",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.9.2",
    "lucide-react": "^0.503.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "react-router-dom": "^7.5.2",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.3",
    "zustand": "^5.0.4",
    "@tauri-apps/api": "^2.5.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/android": "^7.2.0",
    "@eslint/js": "^9.25.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.3",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-window": "^7.3.0"
  }
}
